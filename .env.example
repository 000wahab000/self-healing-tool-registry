# Live agents use NVIDIA NIM; LLM_MODEL may be overridden.
NVIDIA_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Optional Jev classifier credentials, independent of the agent key.
# Leave blank to disable Jev. OPENROUTER_API_KEY is an optional Jev-only fallback.
JEV_API_KEY=
JEV_URL=
JEV_MODEL=
OPENROUTER_API_KEY=
# Header values the healer may inject (must match the mock's token)
OAUTH_BEARER=Bearer test-token
TENANT_ID=t-1
# Dashboard store file (default: a temp file); server ports
DB_PATH=
MOCK_PORT=8000
DASHBOARD_PORT=8080
# Set to 1 to run the paid live end-to-end tests
RUN_E2E=
