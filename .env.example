# Live agents use NVIDIA NIM; LLM_MODEL may be overridden.
NVIDIA_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Optional Jev classifier credentials, independent of the agent key.
# Leave blank to disable Jev. OPENROUTER_API_KEY is an optional Jev-only fallback.
JEV_API_KEY=
JEV_URL=
JEV_MODEL=
OPENROUTER_API_KEY=
# Header values the healer may inject (must match the mock's token)
OAUTH_BEARER=Bearer test-token
TENANT_ID=t-1
# Local unified launcher defaults: REST mock on 8000, dashboard+MCP on 8080.
# A platform-injected PORT selects the web port and defaults HOST to 0.0.0.0;
# without PORT, HOST defaults to 127.0.0.1. Set DB_PATH to a persistent SQLite
# volume in deployment; local default is root healer.db.
DB_PATH=
MOCK_PORT=8000
# PORT is normally supplied by the deployment platform. Uncomment to override:
# PORT=8080
# Remote MCP: configure the token variable NAME and exact host/origin allowlists.
# Store the actual HEALER_MCP_TOKEN value in the deployment secret manager, not here.
# MCP_TOKEN_ENV=HEALER_MCP_TOKEN
# MCP_ALLOWED_HOSTS=registry.example.com
# MCP_ALLOWED_ORIGINS=https://registry.example.com
# Set to 1 to run the paid live end-to-end tests
RUN_E2E=
