# LLM agents and Jev via OpenRouter (one key covers both)
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
# Optional: call Jev on TypeSafe directly instead of OpenRouter
JEV_API_KEY=
JEV_URL=
JEV_MODEL=
# Header values the healer may inject (must match the mock's token)
OAUTH_BEARER=Bearer test-token
TENANT_ID=t-1
# Dashboard store file (default: a temp file); server ports
DB_PATH=
MOCK_PORT=8000
DASHBOARD_PORT=8080
# Set to 1 to run the paid live end-to-end tests
RUN_E2E=
